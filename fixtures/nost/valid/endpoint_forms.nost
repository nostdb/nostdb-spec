@nost 3

@link "./packages/child"
@link "./packages/shared" as shared

schema Function {
  name: string,
}

node login: Function {
  name: "login",
}

node database: Function {
  name: "primary",
}

edge login -> database :CALLS {}

edge login -> shared::authorize :CALLS {}

edge login -> "./packages/child"::handle :CALLS {}
