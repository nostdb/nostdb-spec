@nost 2

// A leading comment on the link group.
@link "./packages/child" // trailing on a link

/* A block comment between declarations. */

schema Sample {
  // leading on a field
  name: string, // trailing on a field
  // a comment at the end of a field block
}

// leading on a node
node example: Sample {
  // leading on a property
  name: "value", // trailing on a property
  // a comment at the end of a record block
}

// a comment at the end of the file
