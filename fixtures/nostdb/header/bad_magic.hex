# bad_magic
# The final magic byte is wrong; the header checksum is still correct.
#
# Whitespace is insignificant and '#' starts a comment.

4E4F535444421A0B                  # magic "NOSTDB" 1A 0A
02000000                          # nostdb_format_version = 2
30000000                          # header_length = 48
0100000000000000                  # database_generation = 1
3000000000000000                  # section_table_offset = 48
00000000                          # section_count = 0
00000000                          # flags = 0x00000000
00000000                          # reserved = 0
02300A57                          # header_crc32c = 0x570A3002 over bytes 0..44
