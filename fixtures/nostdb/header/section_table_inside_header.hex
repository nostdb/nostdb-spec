# section_table_inside_header
# section_table_offset points inside the header.
#
# Whitespace is insignificant and '#' starts a comment.

4E4F535444421A0A                  # magic "NOSTDB" 1A 0A
02000000                          # nostdb_format_version = 2
30000000                          # header_length = 48
0100000000000000                  # database_generation = 1
1000000000000000                  # section_table_offset = 16
01000000                          # section_count = 1
00000000                          # flags = 0x00000000
00000000                          # reserved = 0
1654096D                          # header_crc32c = 0x6D095416 over bytes 0..44
02000000                          # section_kind = 2 (nodes)
00000000                          # reserved = 0
5000000000000000                  # offset = 80
0400000000000000                  # length = 4
8E77DCF1                          # crc32c = 0xF1DC778E
00000000                          # reserved2 = 0
DEADBEEF                          # payload at offset 80
