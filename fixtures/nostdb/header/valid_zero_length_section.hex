# valid_zero_length_section
# A zero-length section carries the CRC-32C of the empty input.
#
# Whitespace is insignificant and '#' starts a comment.

4E4F535444421A0A                  # magic "NOSTDB" 1A 0A
03000000                          # nostdb_format_version = 3
30000000                          # header_length = 48
0100000000000000                  # database_generation = 1
3000000000000000                  # section_table_offset = 48
01000000                          # section_count = 1
00000000                          # flags = 0x00000000
00000000                          # reserved = 0
2C2ED2AA                          # header_crc32c = 0xAAD22E2C over bytes 0..44
09000000                          # section_kind = 9 (links)
00000000                          # reserved = 0
5000000000000000                  # offset = 80
0000000000000000                  # length = 0
00000000                          # crc32c = 0x00000000
00000000                          # reserved2 = 0
