{
  "settings_version": 1,
  "database": {
    "path": "root.nostdb",
    "nost": false
  },
  "analysis": {
    "ai_mode": "auto",
    "max_input_tokens": null,
    "max_output_tokens": null,
    "max_cost_usd": null,
    "on_budget_exceeded": "ask"
  },
  "links": [
